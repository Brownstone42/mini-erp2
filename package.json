{
  "name": "mini-erp-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:check": "next typegen && npm run typecheck && vitest run --reporter=default --reporter=junit --outputFile=reports/unit.xml && npm run build && npm run test:e2e",
    "docker:up": "docker compose -f compose.docker.yaml up -d --build --wait --wait-timeout 180",
    "docker:down": "docker compose -f compose.docker.yaml down",
    "docker:status": "docker compose -f compose.docker.yaml ps -a",
    "test:docker": "node tests/docker/persistence.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test:e2e": "playwright test",
    "test:r2": "vitest run tests/acceptance/r2.test.ts && playwright test",
    "test:customer-table": "playwright test tests/e2e/customer-table.spec.ts",
    "test:at-11": "playwright test tests/e2e/at-11.spec.ts",
    "test:at-12": "playwright test tests/e2e/at-12.spec.ts",
    "test:at-13": "playwright test tests/e2e/at-13.spec.ts",
    "test:at-14": "vitest run tests/acceptance/at-14.test.ts && playwright test tests/e2e/at-14.spec.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:at-01": "vitest run tests/acceptance/at-01.test.ts",
    "test:at-02": "vitest run tests/acceptance/at-02.test.ts",
    "test:at-03": "vitest run tests/acceptance/at-03.test.ts",
    "test:at-04": "vitest run tests/acceptance/at-04.test.ts",
    "test:at-05": "vitest run tests/acceptance/at-05.test.ts",
    "test:at-06": "vitest run tests/acceptance/at-06.test.ts",
    "test:at-07": "vitest run tests/acceptance/at-07.test.ts",
    "test:at-08": "vitest run tests/acceptance/at-08.test.ts",
    "test:at-09": "vitest run tests/acceptance/at-09.test.ts",
    "test:at-10": "vitest run tests/acceptance/at-10.test.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db db-test",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.11.0-beta.19",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
